{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://toc-api.onrender.com/api/:path*" },
    { "source": "/docs", "destination": "https://toc-api.onrender.com/docs" },
    { "source": "/openapi.json", "destination": "https://toc-api.onrender.com/openapi.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
